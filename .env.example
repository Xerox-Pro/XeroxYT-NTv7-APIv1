ALLOWED_ORIGINS=https://your-frontend.vercel.app
# Node authentication option A:
ACCOUNT_API_URL=https://your-primary.your-subdomain.workers.dev
# Option B (all three required, server-only secrets):
# CLOUDFLARE_ACCOUNT_ID=
# D1_DATABASE_ID=
# CLOUDFLARE_API_TOKEN=
# GEMINI_API_KEY=

# Same server-only secret as the frontend gateway
API_SHARED_SECRET=replace-with-a-long-random-secret
REQUIRE_PROXY_SECRET=true
