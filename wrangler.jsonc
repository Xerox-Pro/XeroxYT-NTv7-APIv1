{
  "name": "xeroxyt-ntv7-apiv1",
  "main": "cloudflare/api/bundle.mjs",
  "no_bundle": true,
  "compatibility_date": "2026-11-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [{"name": "REALTIME", "class_name": "RealtimeChannel"}]
  },
  "migrations": [{"tag": "realtime-v1", "new_sqlite_classes": ["RealtimeChannel"]}],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xeroxyt-accounts",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],
  "vars": {
    "NODE_ENV": "production",
    "ALLOWED_ORIGINS": "https://your-frontend.vercel.app",
    "REQUIRE_PROXY_SECRET": "true"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
